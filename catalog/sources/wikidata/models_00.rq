SELECT ?brand ?model ?modelLabel ?inception ?start ?end ?discontinued ?bodyLabel WHERE {
  VALUES ?brand { wd:Q1045210 wd:Q104907477 wd:Q105085729 wd:Q1065539 wd:Q106621124 wd:Q108187217 wd:Q108757682 wd:Q1117001 wd:Q112077124 wd:Q1124857 wd:Q112874951 wd:Q1128836 }
  ?model wdt:P31/wdt:P279* wd:Q3231690 .
  { ?model wdt:P1716 ?brand } UNION { ?model wdt:P176 ?brand }
  OPTIONAL { ?model wdt:P571 ?inception }
  OPTIONAL { ?model wdt:P2031 ?start }
  OPTIONAL { ?model wdt:P2032 ?end }
  OPTIONAL { ?model wdt:P2669 ?discontinued }
  OPTIONAL { ?model wdt:P4519 ?body }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". } }
